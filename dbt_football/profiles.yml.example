# Copy this to ~/.dbt/profiles.yml (or set DBT_PROFILES_DIR to this folder
# and name it profiles.yml - either way, never commit the real profiles.yml).
# All values are read from environment variables - fill them into your
# project-root .env and export them into your shell before running dbt,
# e.g.:
#   set -a; source .env; set +a; dbt build   (bash)

football_analytics:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      # Key-pair auth (preferred - doesn't trigger interactive MFA):
      authenticator: SNOWFLAKE_JWT
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      private_key_passphrase: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PASSPHRASE', '') }}"
      # Fallback for interactive/local use on an MFA-enforced account:
      # comment out the three lines above and uncomment this one instead.
      # password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'FOOTBALL_ANALYTICS_ROLE') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'FOOTBALL_ANALYTICS_WH') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE', 'FOOTBALL_ANALYTICS') }}"
      schema: STAGING
      threads: 4
