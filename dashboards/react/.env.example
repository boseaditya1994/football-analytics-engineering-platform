# Copy to .env.local for local overrides (gitignored). Leave unset for
# local dev - the Vite dev server proxies /api to localhost:8000 instead.
#
# For production (Vercel), set this in the Vercel project's environment
# variables to your deployed backend's origin, no trailing slash:
VITE_API_BASE_URL=https://your-backend.onrender.com
