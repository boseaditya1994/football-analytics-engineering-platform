# Copy to .env and fill in locally. Never commit the real .env file.

# --- football-data.org API ---
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=

# Preferred: key-pair auth (doesn't trigger interactive MFA - required for
# the dashboard API and CI to work non-interactively). See
# snowflake/README.md for how to generate a key and register it.
SNOWFLAKE_PRIVATE_KEY_PATH=.snowflake_keys/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Fallback: password auth. On an MFA-enforced account this will require an
# interactive Duo approval, so it only works for local/manual use, not CI
# or the dashboard API. Leave SNOWFLAKE_PRIVATE_KEY_PATH set above to skip
# this entirely.
SNOWFLAKE_PASSWORD=

SNOWFLAKE_ROLE=FOOTBALL_ANALYTICS_ROLE
SNOWFLAKE_WAREHOUSE=FOOTBALL_ANALYTICS_WH
SNOWFLAKE_DATABASE=FOOTBALL_ANALYTICS
SNOWFLAKE_SCHEMA=RAW

# --- Pipeline ---
LOG_LEVEL=INFO
