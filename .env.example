# Copy to .env and fill in locally. Never commit the real .env file.

# --- football-data.org API ---
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=EPL_ANALYTICS_ROLE
SNOWFLAKE_WAREHOUSE=EPL_ANALYTICS_WH
SNOWFLAKE_DATABASE=FOOTBALL_ANALYTICS
SNOWFLAKE_SCHEMA=RAW

# --- Pipeline ---
LOG_LEVEL=INFO
